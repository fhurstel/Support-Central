# Required
DATABASE_URL=sqlite+aiosqlite:///./data/service_desk.dev.db
JWT_SECRET=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Runtime data
UPLOAD_DIR=./data/uploads
VOICE_AGENT_SETTINGS_PATH=./data/voice-agent-settings.json

# Optional email
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=support@example.test

# Optional Poppy AI
POPPY_API_URL=https://api.getpoppy.ai
POPPY_API_KEY=

# Optional service-to-service voice agent auth
VOICE_BACKEND_TOKEN=
VOICE_BACKEND_TOKENS=
VOICE_AGENT_ENV_PATH=
ENABLE_DEV_VOICE_TOKEN=false
DEV_VOICE_TOKEN=

# Optional RustDesk
RUSTDESK_HBBS_HOST=127.0.0.1
RUSTDESK_HBBS_PORT=21116
RUSTDESK_RELAY_PORT=21117
RUSTDESK_SERVER_HOST=127.0.0.1
RUSTDESK_KEY_FILE=./data/rustdesk/id_ed25519.pub
RUSTDESK_WEB_CLIENT_DIR=./data/rustdesk-web

# Optional synthetic seed account passwords
SEED_ADMIN_PASSWORD=change-me-admin
SEED_TECH_PASSWORD=change-me-tech
SEED_GUEST_PASSWORD=change-me-guest
